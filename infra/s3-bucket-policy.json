{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadWebGamesOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/webgames/*"
    },
    {
      "Sid": "AllowSesToStoreInboundMailOnly",
      "Effect": "Allow",
      "Principal": {
        "Service": "ses.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/inbound/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceAccount": "REPLACE_WITH_ACCOUNT_ID"
        },
        "StringLike": {
          "AWS:SourceArn": "arn:aws:ses:us-east-1:REPLACE_WITH_ACCOUNT_ID:receipt-rule-set/*:receipt-rule/*"
        }
      }
    }
  ]
}
