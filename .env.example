# Local dev: copy to .env.local. Production: copy to .env.production.local,
# fill in real values, and run `pnpm preflight` (see docs/DEPLOY.md).

# ─── Database ────────────────────────────────────────────────────────────────
# Neon: use the *pooled* connection string. Local: the docker-compose Postgres.
DATABASE_URL=postgres://schuster:schuster@localhost:5432/schuster

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Public origin. Passkeys are bound to this domain (the WebAuthn RP ID).
AUTH_URL=http://localhost:3000
# Required when not on Vercel (Vercel sets it automatically).
AUTH_TRUST_HOST=true

# Magic-link email via Resend (https://resend.com), sent from the mail.schuster.me
# subdomain so the IONOS mailboxes on schuster.me are never affected. Leave empty locally:
# links are printed to the dev server console instead.
AUTH_RESEND_KEY=
EMAIL_FROM="Schuster Media <login@mail.schuster.me>"

# Who may create an account (comma-separated). The very first account is
# always allowed and becomes admin. Existing users can always sign in.
ALLOWED_EMAILS=

# ─── Storage ─────────────────────────────────────────────────────────────────
# s3 (default) or memory (tests only — not usable from a browser).
STORAGE_DRIVER=s3
S3_BUCKET=schuster-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# Only for S3-compatible services (local emulator, MinIO, R2, ...). Leave empty for AWS.
S3_ENDPOINT=http://localhost:5055
S3_FORCE_PATH_STYLE=true
